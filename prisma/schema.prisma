generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

/// One buyer project — survives restarts, deploys and reloads.
/// Sessions are ephemeral; projects are the record.
model Project {
  id        String   @id @default(cuid())
  sessionId String   @unique
  brandName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  DesignVersion[]
  assets    Asset[]
  approvals Approval[]
}

/// Immutable design snapshot. A revision never mutates — it appends a child
/// with parentVersionId + changeSummary, so v1 → v2 → v3 is auditable and a
/// customer can always see what changed and approve a specific version.
model DesignVersion {
  id              String   @id @default(cuid())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  version         Int
  parentVersionId String?
  changeSummary   String?
  /// Full DesignSpec JSON (vehicle, openings, equipment, palette, livery).
  spec            Json
  state           String   @default("concept")
  createdAt       DateTime @default(now())

  assets    Asset[]
  approvals Approval[]

  @@unique([projectId, version])
  @@index([projectId])
}

/// A render or video file. Storage is a URL (object storage / /api/assets),
/// never a base64 data URL in RAM.
model Asset {
  id              String         @id @default(cuid())
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  designVersion   DesignVersion? @relation(fields: [designVersionId], references: [id], onDelete: SetNull)
  designVersionId String?
  kind            String
  view            String?
  url             String
  model           String?
  status          String         @default("ready")
  createdAt       DateTime       @default(now())

  @@index([projectId])
}

/// Who approved which version, when. "Favorite" is browser state; approval
/// freezes a version server-side and cannot be overwritten by a regenerate.
model Approval {
  id              String         @id @default(cuid())
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  designVersion   DesignVersion  @relation(fields: [designVersionId], references: [id], onDelete: Cascade)
  designVersionId String
  state           String         @default("approved")
  approvedBy      String?
  createdAt       DateTime       @default(now())

  @@index([projectId])
}

model BlockGroup {
  geoid            String  @id
  countyFips       String
  countyName       String
  tractCode        String
  centroidLat      Float
  centroidLng      Float
  landAreaSqmi     Float?

  totalPop         Int?
  medianHhIncome   Int?
  pctIncome75kPlus Float?
  pctBachelorsPlus Float?
  pctUnder35       Float?
  avgHhSize        Float?
  pctCarFree       Float?
  pctEnglishOnly   Float?
  pctWhiteNh       Float?
  pctBlack         Float?
  pctAsian         Float?
  pctHispanic      Float?

  wacTotalJobs      Int?
  racTotalWorkers   Int?
  netEmployInflow   Int?
  daytimePopEst     Int?
  pctRetailFoodJobs Float?
  pctHighEarnJobs   Float?

  maxAadt          Int?
  roadTypeDominant String?

  epaWalkability   Float?
  intersectDensEpa Float?
  transitAccess    Float?
  employEntropy    Float?
  jobsPerHousehold Float?
  resDensity       Float?
  empDensity       Float?

  osmIntersectDens Float?
  osmPoiCount      Int?
  osmStreetDensity Float?

  pctCommercial  Float?
  pctResidential Float?

  nearestParkAttend Int?
  parksWithin1mi    Int?

  daytimePopScore Float?
  affluenceIndex  Float?
  pedestrianScore Float?
  commercialScore Float?
  compositeScore  Float?

  dataYear  Int
  updatedAt DateTime @updatedAt

  @@index([countyFips])
  @@index([compositeScore(sort: Desc)])
  @@index([countyFips, compositeScore(sort: Desc)])
  @@index([centroidLat, centroidLng])
}

model Brand {
  id              Int      @id @default(autoincrement())
  name            String
  targetAgeMin    Int?
  targetAgeMax    Int?
  targetIncomeMin Int?
  targetIncomeMax Int?
  pricePoint      String?

  weightDaytime    Float @default(0.25)
  weightPedestrian Float @default(0.25)
  weightCommercial Float @default(0.20)
  weightAffluence  Float @default(0.20)
  weightParks      Float @default(0.10)

  reports   Report[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id            Int      @id @default(autoincrement())
  brand         Brand    @relation(fields: [brandId], references: [id])
  brandId       Int
  marketCounty  String
  marketName    String
  topLocationsN Int      @default(50)
  topLocations  Json
  summary       Json?
  createdAt     DateTime @default(now())

  @@index([brandId])
}
