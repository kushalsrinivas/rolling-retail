# ─────────────────────────────────────────────────────────────────────────────
# Rolling Retail — environment
#
# This is ONE app. The UI and every /api/* route are served by the same
# process on the same origin, so there is no separate frontend/backend URL to
# point at each other. Nothing here needs an API base URL.
#
# Copy to `.env` and fill in. Vite loads `.env` for both dev and build.
#
#   VITE_*  → compiled INTO the browser bundle at build time. Public. Never
#             put a secret here, and remember they must be present when you
#             BUILD, not just when you run.
#   others  → server only, read at runtime.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required: the AI that does the work ──────────────────────────────────────
# Gemini key for the design agent and the concept renders. Without it the app
# still runs and falls back to placeholder images, so the demo never dies.
# GEMINI_API_KEY and GOOGLE_GENAI_API_KEY are accepted as aliases.
GOOGLE_API_KEY=

# Optional model overrides. These are the defaults.
LLM_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-image


# ── Private customer previews ────────────────────────────────────────────────
# Set this and the whole site — pages, /api/agent/*, tRPC — sits behind a
# password, and every response carries X-Robots-Tag: noindex.
# LEAVE IT UNSET for local dev and for the public marketing site.
# Set it on customer subdomains, e.g. foodtruckfactory.rollingretail.co
SITE_PASSWORD=

# Shared secret for GET /api/agent/leads, which returns every buyer's contact
# details. The endpoint returns 401 while this is unset — it fails closed on
# purpose. Send it as `Authorization: Bearer <token>` or `X-Factory-Token`.
FACTORY_DASHBOARD_TOKEN=


# ── Factory reference photos ─────────────────────────────────────────────────
# Real photos of the factory's trailers, read from disk and sent to the image
# model so the nine generated views agree with each other. Defaults to the
# `references/` folder in the repo. Point this at a mounted volume on a host
# with a read-only filesystem, or where the bundle excludes the folder.
# REFERENCES_DIR=/var/data/rolling-retail/references


# ── 3D generation (the /studio route only) ───────────────────────────────────
# Hyper3D Rodin. Only needed if you use /studio; the designer at /chat and the
# landing page do not touch it.
RODIN_API_KEY=

# Extra hosts the download proxy is allowed to fetch from, comma-separated.
# hyper3d.com, deemos.com and rodin.ai are allowed by default. Add the CDN
# Rodin actually serves from if a download fails with "Host not allowed".
# RODIN_DOWNLOAD_HOSTS=cdn.example.com


# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. Required by the tRPC routers and the /report page. The designer at
# /chat does NOT use it — its sessions are in memory — so you can run the
# demo without a database today.
# src/db.ts asserts this is present, so an invalid value fails at import.
DATABASE_URL=


# ── Auth ─────────────────────────────────────────────────────────────────────
# better-auth reads both of these from the environment itself.
# Generate the secret with: npx -y @better-auth/cli secret
# Without BETTER_AUTH_URL you get a startup warning and broken callbacks.
# Nothing is gated by auth yet, so neither is required to run the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000


# ── Client bundle (public — compiled in at build time) ───────────────────────
# Name stamped on downloaded concept renders. Defaults to "Food Truck Factory".
# Change it per white-label client.
VITE_WATERMARK_TEXT=Food Truck Factory

# Mapbox token for the map on /report. Without it that section shows a
# developer message; nothing else is affected.
VITE_MAPBOX_TOKEN=

# PostHog. Note: nothing in the app calls posthog.capture() yet, so this
# currently records autocapture only.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com


# ── Build / hosting ──────────────────────────────────────────────────────────
# Nitro output target. Auto-detected: "vercel" when VERCEL=1 is set by the
# build environment, otherwise "node-server". Override for any other host.
# NITRO_PRESET=node-server

# Port for `npm run dev` (3000) and for the built node server.
# PORT=3000
